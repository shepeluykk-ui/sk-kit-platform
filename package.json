{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:security": "tsx tests/security/auth-and-idor.test.ts",
    "test:e2e": "tsx tests/e2e/phase9-domain-entities.test.ts",
    "test:orchestrator": "tsx tests/orchestrator/orchestration.test.ts",
    "test:rt002": "tsx tests/orchestrator/rt002-concurrent-analysis.test.ts",
    "test:rt003": "tsx tests/orchestrator/rt003-persistence.test.ts",
    "test:r3013": "tsx tests/orchestrator/r3013-ownership.test.ts",
    "test:r30131": "tsx tests/orchestrator/r30131-ownership-lifecycle.test.ts",
    "test": "npm run test:orchestrator && npm run test:rt002 && npm run test:rt003 && npm run test:r3013 && npm run test:r30131"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/genai": "^2.4.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.16",
    "@tailwindcss/vite": "^4.1.14",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
